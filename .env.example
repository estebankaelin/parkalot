# Kopieren nach .env.local und ausfüllen. Ohne diese Werte läuft die App mit Beispieldaten im Testmodus.
# Supabase: Project Settings > API (Project URL und Publishable key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stripe: Developers > API keys (Publishable key, pk_test_... oder pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
